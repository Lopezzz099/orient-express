# Todas las variables son opcionales: el sitio compila y funciona sin ninguna.

# URL pública del sitio (para metadatos Open Graph y sitemap). En Vercel se usa VERCEL_PROJECT_PRODUCTION_URL si no se define.
NEXT_PUBLIC_SITE_URL=

# Servidor de teselas del mapa de Operaciones. Por defecto: https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
